    <color name="colorPrimaryDark">#153529</color>
    <color name="colorPrimaryMuted">#CFE3D8</color>   <!-- secondary text on the green header -->
    <color name="colorSecondary">#E8A11A</color>
    <color name="colorSecondaryDark">#8A5700</color>  <!-- turmeric dark enough for text on white (6:1) -->

    <!-- The "ready to cook" call-out (turmeric tint) -->
